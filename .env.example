# Copy to .env and adjust paths for your machine.

# Vector store & chunks (defaults under data/ and processed/)
# VECTORSTORE_DIR=data/vectorstore
# CHUNKS_PATH=processed/chunks.json

# Ollama
CHAT_MODEL=mistral:7b
VISION_MODEL=llama3.2-vision
ENABLE_VISION_LLM=false

# Embeddings & retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HARDWARE_PROFILE=cpu
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
ENABLE_RERANK=true

# Frontend dev server (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Debug: retrieval panel in API + console dumps in rag_pipeline
DEBUG_PAYLOADS=false

# Sessions (optional SQLite persistence)
USE_SQLITE_SESSIONS=false

# Legacy ONNX classifier (not used by default; app uses skin_classifier_v2.pth)
ENABLE_CLASSIFIER=false
